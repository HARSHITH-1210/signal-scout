# Copy to .env.local (dev) or .env (docker compose) and fill in. Never commit real keys.

# --- LLM: set ONE of these two keys ---------------------------------------------------------
# Anthropic (Claude). Default model: claude-opus-5-5
ANTHROPIC_API_KEY=
# Optional: override the Claude model, e.g. claude-sonnet-5-5 (cheaper)
ANTHROPIC_MODEL=

# OpenRouter (any model, including free ":free" models) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: OpenRouter model id. Must support structured outputs. Default: nvidia/nemotron-3.5-super-vl:free
OPENROUTER_MODEL=

# Optional: force the LLM backend ("anthropic" or "openrouter"). If blank: Anthropic when its key is
# set, otherwise OpenRouter when its key is set.
LLM_PROVIDER=

# --- Fallbacks (optional, recommended): see docs/RESILIENCE_PLAN.md ------------------------
# Backup AI provider, used when the primary fails or runs out of quota (a different provider, so it has its
# own quota). Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: Gemini model (default: gemini-flash-latest)
GEMINI_MODEL=
# Optional: Gemini models tried when the main one is overloaded (503) or retired (404), or "none".
# Default: gemini-flash-lite-latest,gemini-2.5-flash
GEMINI_FALLBACK_MODELS=
# Optional: fallback order after the primary, e.g. "gemini,anthropic", or "none" (default: every provider with a key)
LLM_FALLBACKS=
# Optional: up to 2 extra OpenRouter models tried in the same request (they share OpenRouter's quota)
OPENROUTER_FALLBACK_MODELS=
# Backup search provider ($10 free credit a month, no card): https://dashboard.exa.ai
EXA_API_KEY=
# Optional: raises Jina Reader's keyless rate limit (used to read pages when Tavily and Exa can't)
JINA_API_KEY=
# Demo/drill only: simulate provider failures, e.g. "tavily:quota,openrouter:down" (kinds: quota, down, auth, invalid, slow).
# Leave blank in normal use.
FAULT_INJECT=

# --- Search (required) ----------------------------------------------------------------------
# Tavily API key (web + news search, page extraction) — https://app.tavily.com
TAVILY_API_KEY=

# Optional: where the SQLite database lives (default: ./data)
DATA_DIR=./data

# Optional: extra hostnames the app may be served under, comma-separated (e.g. scout.mycompany.com).
# localhost, IP addresses and *.local always work. Any other Host header is refused (DNS-rebinding protection).
ALLOWED_HOSTS=

# --- Google sign-in + Gmail sending (optional locally, REQUIRED when hosted) -----------------
# When set, the whole app requires "Sign in with Google", and the account you sign in with is the Gmail
# approved drafts are sent from (scopes: gmail.send + gmail.metadata headers; it can't read message bodies).
# Create an OAuth "Web application" client in Google Cloud Console; see docs/LIVE_TESTING_SETUP.md § Gmail.
# Leave blank for no sign-in (local use only) and review-only approval. /api/health stays public.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorised redirect URI on the OAuth client. Open the app at this same host.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# Who may sign in: comma-separated addresses or @domain.com entries (e.g. you@gmail.com,@yourcompany.com). Blank: the first account to sign in
# becomes the owner and is the only one let in afterwards. Recommended when hosted.
ALLOWED_EMAILS=
# Optional: key for the session cookie (default: derived from GOOGLE_CLIENT_SECRET)
SESSION_SECRET=
